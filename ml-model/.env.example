# ============================================================================
# SIFRA AI — ML Service Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it contains environment-specific configuration.
# This example file is safe to commit.
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# Port the FastAPI server listens on. [OPTIONAL] default: 8000
PORT=8000

# ----------------------------------------------------------------------------
# ML Service Authentication — [REQUIRED in production]
# ----------------------------------------------------------------------------

# Shared secret for authenticating backend-to-ML service requests.
# The Express backend sends this as the X-ML-Service-Secret header on every
# /predict call. Must match ML_SERVICE_SECRET on the Backend service.
# Generate with: openssl rand -hex 32
ML_SERVICE_SECRET=your_ml_service_secret_here

# ----------------------------------------------------------------------------
# CORS Configuration — [OPTIONAL]
# ----------------------------------------------------------------------------

# Comma-separated list of allowed browser origins for CORS.
# In production, set this to your frontend URL(s). If unset, no browser
# origins are allowed in production (backend-to-backend calls only).
ML_CORS_ORIGINS=https://sifra-ai-1.onrender.com

# ----------------------------------------------------------------------------
# Model Configuration — [OPTIONAL]
# ----------------------------------------------------------------------------

# Directory containing the trained model artifacts.
MODEL_DIRECTORY=models

# ============================================================================
# Notes
# ============================================================================
# - ML_SERVICE_SECRET: required in production. If missing, the ML service will
#   skip authentication (local development only).
# - ML_CORS_ORIGINS: required in production to allow browser access from the
#   frontend. Defaults to localhost in development, no origins in production.
# ============================================================================
