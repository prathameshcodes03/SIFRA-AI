# ============================================================================
# SIFRA AI — Frontend Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it contains environment-specific configuration.
# This example file is safe to commit.
#
# VITE_ variables are exposed to client-side code by Vite.
# Never place secrets here: database passwords, JWT secrets, ElevenLabs keys,
# Brevo keys, or ImageKit private keys must remain backend-only.
# ============================================================================

# Backend API URL. Set to the production backend's public URL when deployed.
# Local development defaults to http://localhost:3000.
VITE_API_URL=http://localhost:3000

# ============================================================================
