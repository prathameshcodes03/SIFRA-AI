generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id String @id @default(uuid())

  fullName String
  email    String @unique
  password String

  age    Int
  gender Gender
  weight Float

  profileImage String?

  tokenVersion Int @default(0)

  workouts Workout[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String   @id @default(uuid())
  email      String
  hashedOtp  String
  expiresAt  DateTime
  lastSentAt DateTime
  attempts   Int      @default(0)
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model Workout {
  id String @id @default(uuid())

  exercise String

  sets Int

  reps Int

  completed Boolean @default(false)

  accuracy Float?

  /// Count of SCORED FORM SAMPLES for this session: the repetitions whose form
  /// could actually be judged. Excludes repetitions that could not be measured
  /// (pose not visible, model unavailable, no network) - those are never
  /// counted as incorrect form.
  totalPredictions Int @default(0)

  /// Subset of totalPredictions whose form was judged correct.
  correctPredictions Int @default(0)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId, completed])
}

