generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id String @id @default(uuid())

  fullName String
  email    String @unique
  password String

  age    Int
  gender Gender
  weight Float

  profileImage String?

  workouts Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workout {
  id String @id @default(uuid())

  exercise String

  sets Int

  reps Int

  completed Boolean @default(false)

  accuracy Float?

  /// Count of genuine form classifications received from the model for THIS
  /// exercise. Excludes network failures, invalid payloads, unavailable-model
  /// fallbacks, and labels belonging to a different exercise.
  totalPredictions Int @default(0)

  /// Subset of totalPredictions that were correct form for the exercise.
  correctPredictions Int @default(0)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId, completed])
}

