# ============================================================================
# SIFRA AI — Backend Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is gitignored. This example file is safe to commit.
#
# VARIABLES MARKED [REQUIRED] MUST be set for the server to start.
# VARIABLES MARKED [OPTIONAL] have defaults or degrade gracefully.
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# Port the Express server listens on. [OPTIONAL] default: 3000
PORT=3000

# ----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma) — [REQUIRED]
# ----------------------------------------------------------------------------

# Primary Prisma connection string (pooled, with sslmode=require for Neon).
# Example format: postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Direct (non-pooled) connection string, used for Prisma migrations.
# [OPTIONAL] defaults to DATABASE_URL if not set.
DIRECT_DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# ----------------------------------------------------------------------------
# Authentication — [REQUIRED]
# ----------------------------------------------------------------------------

# Secret used to sign and verify JWT access tokens.
# Use a long, random string. Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ----------------------------------------------------------------------------
# Frontend URL — [OPTIONAL]
# ----------------------------------------------------------------------------

# Public URL of the React frontend, used for CORS and password-reset links.
# Defaults to http://localhost:5173 in development.
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# ML Service (Python FastAPI) — [OPTIONAL]
# ----------------------------------------------------------------------------

# Base URL of the form-prediction ML service.
# Local default: http://127.0.0.1:8000
# On Render, set this to the ML service's public URL.
ML_SERVICE_URL=http://127.0.0.1:8000

# ----------------------------------------------------------------------------
# ImageKit (profile image upload) — [OPTIONAL]
# ----------------------------------------------------------------------------

# Get these from your ImageKit dashboard.
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-url-endpoint

# ----------------------------------------------------------------------------
# Brevo (transactional email for OTP and password reset) — [OPTIONAL]
# ----------------------------------------------------------------------------

# Brevo API key. Get from your Brevo dashboard.
BREVO_API_KEY=your_brevo_api_key

# Sender email address verified in Brevo.
EMAIL_SENDER=your-sender@example.com

# ----------------------------------------------------------------------------
# ElevenLabs (AI voice coaching TTS) — [OPTIONAL]
# ----------------------------------------------------------------------------

# ElevenLabs API key. Never expose this to the frontend — it is backend-only.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ElevenLabs voice ID for coaching audio.
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# ElevenLabs model ID. Default: eleven_flash_v2_5
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# - JWT_SECRET: required. If missing, the server refuses to start.
# - DATABASE_URL: required. If missing, the server refuses to start.
# - ELEVENLABS_API_KEY: required for voice coaching; without it, /api/voice/coaching returns 500.
# - BREVO_API_KEY / EMAIL_SENDER: required for OTP email delivery; without it, registration and password reset emails fail.
# - IMAGEKIT keys: required for profile image uploads; without it, image upload fails.
# ============================================================================
